library(dplyr)
genome_seqs = seqs
gapless_genome = DNAStringSet(gsub("-", "", as.character(genome_seqs)))
# PWM hits per sequence (forward strand)
counts_fwd = sapply(gapless_genome, function(x) countPWM(pwm, x, min.score = "55%"))
# reverse complement
rc_genome = reverseComplement(gapless_genome)
counts_rev = sapply(rc_genome, function(x) countPWM(pwm, x, min.score = "55%"))
# total hits per sequence (both strands)
total_counts = counts_fwd + counts_rev
# Lambda = average number of STAT1 sites per genome sequence
lambda = mean(total_counts)
cat("Lambda (mean STAT1 sites per sequence):", lambda, "\n")
# count hits in your sequence of interest
observed_fwd = countPWM(pwm, gapless_genome[[1]], min.score = "55%")
observed_rev = countPWM(pwm, reverseComplement(rc_genome[[1]]), min.score = "55%")
observed = observed_fwd + observed_rev
# Poisson test: is observed significantly different from lambda?
poisson.test(observed, r = lambda)
lambda
counts
counts_fwd
poisson.test(observed, r = lambda)
observed
bootstrap_tajimas
