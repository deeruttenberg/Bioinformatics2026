rownames(dist_matrix) <- colnames(dist_matrix) <- names(query)
for (i in 1:n) {
for (j in i:n) {
dist_matrix[i, j] <- dist_matrix[j, i] <- p_distance(filtered_matrix[i, ], filtered_matrix[j, ])
}
}
dist_obj <- as.dist(dist_matrix)
