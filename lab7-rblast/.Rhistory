# Keep only columns where NO haplotype has a gap
no_indel_cols <- apply(seq_matrix, 2, function(col) !any(col == "-"))
filtered_matrix <- seq_matrix[, no_indel_cols]
# Reconstruct as DNAStringSet
filtered_seqs <- DNAStringSet(apply(filtered_matrix, 1, paste, collapse = ""))
# New distance matrix and NJ tree on gap-free alignment
dist_no_indel <- stringDist(filtered_seqs, method = "hamming")
nj_tree_filtered <- nj(dist_no_indel)
plot(nj_tree_filtered)
motif_seqs
